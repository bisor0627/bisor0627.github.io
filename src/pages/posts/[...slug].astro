---
import Base from "../../layouts/Base.astro";
import { formatDate, getPosts, type Post } from "../../utils/posts";

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((entry, i) => ({
		params: { slug: entry.slug },
		props: { entry, newer: posts[i - 1], older: posts[i + 1] },
	}));
}

interface Props {
	entry: Post;
	newer?: Post;
	older?: Post;
}

const { entry, newer, older } = Astro.props;
const { Content } = await entry.render();
const { title, description, published, tags } = entry.data;
---

<Base title={title} description={description || title}>
	<a class="back" href="/#log">← log</a>
	<article>
		<header class="post-header">
			<div class="post-meta">
				{formatDate(published)}{tags.length > 0 && ` · ${tags.join(", ")}`}
			</div>
			<h1>{title}</h1>
		</header>
		<div class="prose">
			<Content />
		</div>
	</article>
	{(older || newer) && (
		<nav class="post-nav">
			{older && (
				<a href={`/posts/${older.slug}/`}>
					<span class="mono">← 이전</span>
					{older.data.title}
				</a>
			)}
			{newer && (
				<a class="next" href={`/posts/${newer.slug}/`}>
					<span class="mono">다음 →</span>
					{newer.data.title}
				</a>
			)}
		</nav>
	)}
</Base>
